# Nitro production server
NODE_ENV=production
HOST=127.0.0.1
PORT=4173
LOG_LEVEL=info

# Persistent state; keep both files private and back them up together
DB_PATH=./data/jellything.db
CONFIG_PATH=./data/config.json

# Keep false for direct connections. Enable only behind a trusted proxy that
# overwrites forwarded headers and is the sole path to this server.
TRUST_PROXY=false
